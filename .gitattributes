# Pin byte-exact test fixtures to LF on checkout so core.autocrlf=true
# clones compare equal against the committed (normalized LF) blobs.
crates/ui/tests/fixtures/*.json text eol=lf
# Same rationale for the byte-locked golden artifacts: the comparison is
# against `serde_json::to_string_pretty` output, which is LF-only, so a CRLF
# checkout makes every line differ by its terminator.
tests/golden/**/*.json text eol=lf
# Same rationale for test-run artifact files written under tests/fixtures: an
# unpinned path under core.autocrlf=true re-dirties its stat entry on every
# full test run even while its content stays byte-equal to HEAD.
tests/fixtures/**/artifacts/**/*.json text eol=lf
# Same rationale for the AR-31 tokenizer byte-oracle files: the comparison
# is a byte-exact read of these .txt oracles against re-tokenized fixture
# streams, so a CRLF smudge on checkout makes every oracle line differ by
# its terminator (caught at the shining-enthusiasm -> main merge 2026-10-12:
# green in the authoring worktree, red on the smudged copy).
crates/lang-cpp/tests/tokenizer_oracles/** text eol=lf

# Same rationale for the rust-language frozen fixture tree (AR-31/F12 class,
# caught at the rust-language merge to main 2026-10-30: green in the authoring
# worktree, red on the CRLF-smudged copy - the rust suites match fixture
# bytes with LF literals): the fixtures are frozen byte-exact trees.
tests/fixtures/rust-basic/** text eol=lf
